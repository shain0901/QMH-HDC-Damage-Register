# Copy this to .env for local dev, and set the same names as Environment Variables in the
# Vercel project settings for the real deployment.

# Postgres connection string — from Vercel Postgres, Neon, or Supabase.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random secret used to sign session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Resend (resend.com) API key, used to send magic-link sign-in emails.
RESEND_API_KEY=re_xxx

# Must be a sender address on a domain you've verified in Resend.
EMAIL_FROM="QMH Damage Register <noreply@hanmersolutions.co.nz>"

# The deployed app's own URL (no trailing slash) — used to build the link inside sign-in emails.
# Locally this is usually http://localhost:3000; in production, your vercel.app URL or custom domain.
APP_BASE_URL=http://localhost:3000

# Auto-provided by Vercel once you add Blob storage to the project (Storage tab → Create Database
# → Blob). You shouldn't need to set this by hand except for local dev.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
